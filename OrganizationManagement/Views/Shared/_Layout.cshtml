@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OrganizationManagement</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />


    @* <style> *@
    @*     .custom-card { *@
    @*         background-color: #2c2f33; /* Dark gray background */ *@
    @*         color: darkblue; *@
    @*         background: linear-gradient(145deg, #fdfdfd, #f1f3f5); *@
    @*         border-radius: 16px; *@
    @*         transition: all 0.2s ease-in-out; *@
    @*     } *@

    @*         .custom-card:hover { *@
    @*             transform: scale(1.02); *@
    @*             box-shadow: 0 0.8rem 1.5rem rgba(0, 0, 0, 0.1); *@
    @*         } *@

    @*         .custom-card .card-title { *@
    @*             background-color: #e3f2fd; *@
    @*             padding: 10px 15px; *@
    @*             border-radius: 10px; *@
    @*         } *@
    @* </style> *@

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">OrganizationManagement</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse d-flex justify-content-end">
                    <ul class="navbar-nav flex-grow-1"></ul>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <!-- Admin Logged In -->
                        <span class="me-2 text-primary fw-bold">👑 @User.Identity.Name (Admin)</span>
                        <form method="post" asp-controller="Home" asp-action="Logout" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger">🔐 Logout</button>
                        </form>
                    }
                    else if (Context.Request.Cookies["UserId"] != null)
                    {
                        <!-- Normal User Logged In via Cookie -->
                        var userName = Context.Request.Cookies["UserName"];
                        <span class="me-2 text-success fw-bold">🙋‍♀️ @userName (User)</span>
                        <form method="get" asp-controller="Account" asp-action="Logout" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger">🔐 Logout</button>
                        </form>
                    }
                    else
                    {
                        <!-- No User Logged In -->
                        <div id="loginForm">
                            <a class="btn btn-outline-primary me-2" asp-controller="Home" asp-action="Login">🔐 Login (Admin)</a>
                           
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

   

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
