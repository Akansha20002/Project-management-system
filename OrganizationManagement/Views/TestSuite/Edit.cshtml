@model OrganizationManagement.DTO.TestSuiteDTO

<h2>Edit Test Suite</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="TestSuiteId" />
    <input type="hidden" asp-for="TestPlanId" />

    <div class="form-group">
        <label for="Name">Test Suite Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="Description">Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>

<a asp-action="Details" asp-controller="TestPlan" asp-route-id="@Model.TestPlanId" class="btn btn-secondary">Cancel</a>
