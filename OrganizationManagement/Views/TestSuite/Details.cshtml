@model OrganizationManagement.Models.TestSuite

<div>
    <h4>Test Cases</h4>
    <ul>
        @foreach (var testCase in Model.TestCases)
        {
            <li>
                <a href="@Url.Action("Details", "TestCase", new { id = testCase.Id })">@testCase.Title</a>
            </li>
        }
    </ul>

    <button class="btn btn-sm btn-primary" onclick="toggleForm()">Add Test Case</button>

    <div id="testCaseForm" style="display: none; margin-top: 20px;">
        <form asp-action="Create" asp-controller="TestCase" method="post">
            <input type="hidden" name="TestSuiteId" value="@Model.TestSuiteId" />

            <div class="form-group">
                <label for="Title">Title</label>
                <input type="text" name="Title" class="form-control" required />
            </div>

            <div class="form-group">
                <label for="Description">Description</label>
                <textarea name="Description" class="form-control" rows="3" required></textarea>
            </div>

            <div class="form-group">
                <div class="form-check">
                    <input type="hidden" name="IsAutomated" value="false" />
                    <input type="checkbox" name="IsAutomated" class="form-check-input" value="true" />
                    <label class="form-check-label">Is Automated?</label>
                </div>
            </div>

            <h5>Test Steps</h5>
            <div id="stepsContainer">
                <div class="step-item">
                    <label>Step 1</label>
                        <div class="form-group">
                        <label for="TestSteps[0].ExpectedResult">Expected Result</label>
                        <input type="text" name="TestSteps[0].ExpectedResult" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label for="TestSteps[0].ActualResult">Actual Result</label>
                        <input type="text" name="TestSteps[0].ActualResult" class="form-control" />
                    </div>
                </div>
            </div>

            <button type="button" class="btn btn-secondary btn-sm" onclick="addStep()">Add Step</button>

            <div style="margin-top: 15px;">
                <button type="submit" class="btn btn-success btn-sm">Save</button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="toggleForm()">Cancel</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let stepCount = 1;

        function toggleForm() {
            const form = document.getElementById('testCaseForm');
            form.style.display = (form.style.display === 'none') ? 'block' : 'none';
        }

        function addStep() {
            stepCount++;
            const stepsContainer = document.getElementById('stepsContainer');

            const stepDiv = document.createElement('div');
            stepDiv.className = 'step-item';
            stepDiv.innerHTML = `
                <label>Step ${stepCount}</label>
                <div class="form-group">
                    <label for="TestSteps[${stepCount - 1}].ExpectedResult">Expected Result</label>
                    <input type="text" name="TestSteps[${stepCount - 1}].ExpectedResult" class="form-control" required />
                </div>
                <div class="form-group">
                    <label for="TestSteps[${stepCount - 1}].ActualResult">Actual Result</label>
                    <input type="text" name="TestSteps[${stepCount - 1}].ActualResult" class="form-control" />
                </div>
            `;

            stepsContainer.appendChild(stepDiv);
        }
    </script>
}
