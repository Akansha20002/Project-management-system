@{
}
@model IEnumerable<OrganizationManagement.Models.TestSuite>
@{
    ViewBag.Title = "Test Suites";
}

<h2>Test Suites</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var suite in Model)
        {
            <tr>
                <td>@suite.Name</td>
                <td>@suite.Description</td>
                <td>
                    <a href="@Url.Action("Edit", "TestSuite", new { TestSuiteId = suite.TestSuiteId })" class="btn btn-primary">Edit</a>
                    <form action="@Url.Action("Delete", "TestSuite", new { id = suite.TestSuiteId, testPlanId = ViewBag.TestPlanId })" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this test suite?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a href="@Url.Action("Add", "TestSuite", new { testPlanId = ViewBag.TestPlanId })" class="btn btn-success">Add New Test Suite</a>
