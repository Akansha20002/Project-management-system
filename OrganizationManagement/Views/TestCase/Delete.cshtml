@model OrganizationManagement.DTO.TestCaseDTO
@{
    ViewData["Title"] = "Delete Test Case";
}

<h1>Delete Test Case</h1>

<div class="alert alert-warning">
    <h4 class="alert-heading">Are you sure you want to delete this Test Case?</h4>
    <p><strong>Title:</strong> @Model.Title</p>
    <p><strong>Description:</strong> @Model.Description</p>
    <p><strong>Steps:</strong> @Model.Steps</p>
    <p><strong>Automated:</strong> @(Model.IsAutomated ? "Yes" : "No")</p>
</div>

<form method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a href="@Url.Action("Details", "TestSuite", new { id = Model.TestSuiteId })" class="btn btn-secondary">Cancel</a>
</form>
