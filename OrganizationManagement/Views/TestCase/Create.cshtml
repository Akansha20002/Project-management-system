@model OrganizationManagement.DTO.TestCaseDTO


<h2>Create Test Case</h2>

<form asp-action="Create">
    <!-- Hidden input to store TestSuiteId -->
    <input type="hidden" asp-for="TestSuiteId" />

    <div class="form-group">
        <label for="Title">Title</label>
        <input type="text" asp-for="Title" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="Description">Description</label>
        <textarea asp-for="Description" class="form-control" required></textarea>
    </div>

    <div class="form-group">

        <label for="Steps">Steps</label>
        <textarea asp-for="Steps" class="form-control" required></textarea>
    </div>

    <div class="form-group">
        <div class="form-check">
            <input asp-for="IsAutomated" class="form-check-input" type="checkbox" />
            <label asp-for="IsAutomated" class="form-check-label">Is Automated?</label>
        </div>
        <span asp-validation-for="IsAutomated" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create Test Case</button>
</form>
