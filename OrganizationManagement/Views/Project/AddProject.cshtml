@model OrganizationManagement.DTO.ProjectDTO

<h2>Add New Project</h2>

<form asp-action="AddProject" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="OrganizationId" />

    <div>
        <label asp-for="ProjectName"></label>
        <input asp-for="ProjectName" />
    </div>

    <div>
        <label asp-for="Status"></label>
        <input asp-for="Status" />
    </div>

    <div>
        <label asp-for="Description"></label>
        <textarea asp-for="Description"></textarea>
    </div>

    <div>
        <label asp-for="StartDate"></label>
        <input asp-for="StartDate" type="date" />
    </div>

    <div>
        <label asp-for="EndDate"></label>
        <input asp-for="EndDate" type="date" />
    </div>

    <button type="submit">Add Project</button>
</form>
