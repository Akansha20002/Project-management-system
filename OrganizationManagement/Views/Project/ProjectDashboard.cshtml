@model OrganizationManagement.DTO.ProjectDTO

<h2>@Model.ProjectName</h2>

<p><strong>Status:</strong> @Model.Status</p>
<p><strong>Description:</strong> @Model.Description</p>
<p><strong>Start Date:</strong> @Model.StartDate.ToString("yyyy-MM-dd")</p>
<p><strong>End Date:</strong> @Model.EndDate.ToString("yyyy-MM-dd")</p>

<h3>Test Plans</h3>
@if (Model.TestPlans != null && Model.TestPlans.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var testPlan in Model.TestPlans)
            {
                <tr>
                    <td>@testPlan.Name</td>
                    <td>
                        <a asp-controller="TestPlan"
                           asp-action="Edit"
                           asp-route-id="@testPlan.TestPlanId"
                           class="btn btn-sm btn-primary">
                            Edit
                        </a>

                        <form asp-controller="TestPlan"
                              asp-action="Delete"
                              asp-route-id="@testPlan.TestPlanId"
                              method="post"
                              style="display:inline;">
                            <input type="hidden" name="projectId" value="@Model.ProjectId" />
                            <button type="submit"
                                    class="btn btn-sm btn-danger"
                                    onclick="return confirm('Are you sure you want to delete this test plan?')">
                                Delete
                            </button>
                        </form>

                        <a asp-controller="TestSuite"
                           asp-action="Index"
                           asp-route-testPlanId="@testPlan.TestPlanId"
                           class="btn btn-sm btn-info ml-2">
                            View Test Suites
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No test plans found for this project.</p>
}

<a asp-action="Add"
   asp-controller="TestPlan"
   asp-route-projectId="@Model.ProjectId"
   class="btn btn-outline-success mt-3">
    + Add New Test Plan
</a>

<hr />

<form asp-action="DeleteProject" method="post">
    <input type="hidden" name="projectId" value="@Model.ProjectId" />
    <button type="submit"
            class="btn btn-danger mt-2"
            onclick="return confirm('Are you sure you want to delete this project?')">
        Delete Project
    </button>
</form>
