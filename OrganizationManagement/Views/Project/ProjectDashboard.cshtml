@model OrganizationManagement.DTO.ProjectDTO

<!-- Bootstrap CSS (if not already in _Layout.cshtml) -->
@* <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" /> *@

<div class="container my-4">
    <div class="card p-4 shadow-sm" style="background-color: #f4f4f4;">
        <h2 class="mb-3">@Model.ProjectName</h2>

        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Start Date:</strong> @Model.StartDate.ToString("yyyy-MM-dd")</p>
        <p><strong>End Date:</strong> @Model.EndDate.ToString("yyyy-MM-dd")</p>
        <div style="color: #f39c12;">
            <a asp-controller="TestPlan" asp-action="Add" asp-route-projectId="@Model.ProjectId"
               class="btn btn-primary mt-3"
               style="width: 150px;">
                ➕ Add Plan
            </a>
        </div>

    </div>

    <hr />

    <h3 class="mt-4">Test Plans</h3>
    @if (Model.TestPlans != null && Model.TestPlans.Any())
    {
        <div class="row">
            @foreach (var testPlan in Model.TestPlans)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 custom-card">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@testPlan.Name</h5>
                            <p class="card-text">
                                @if (!string.IsNullOrWhiteSpace(testPlan.Objective))
                                {
                                    <span><strong>Objective:</strong> @testPlan.Objective</span>
                                    <br />
                                }
                            </p>
                            <a href="@Url.Action("Details", "TestPlan", new { id = testPlan.TestPlanId })"
                               class="btn btn-outline-primary mt-auto" style="width: fit-content;">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }



    else
    {
        <p class="text-muted">No test plans found for this project.</p>
    }

    <hr />

    <form asp-action="DeleteProject" method="post" class="d-flex align-items-center gap-2">
        <input type="hidden" name="projectId" value="@Model.ProjectId" />
        <button type="submit"
                class="btn btn-danger"
                onclick="return confirm('Are you sure you want to delete this project?')">
            🗑️ Delete Project
        </button>
        <a asp-controller="Organization" asp-action="Dashboard" class="btn btn-primary">
            ← Back to Dashboard
        </a>
    </form>
</div>
