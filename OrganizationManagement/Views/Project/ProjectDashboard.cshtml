@model OrganizationManagement.DTO.ProjectDTO

<h2>@Model.ProjectName</h2>

<p>
    <strong>Status:</strong>
    @if (Model.IsCompleted)
    {
        <span style="color:green; font-weight:bold;">Completed ?</span>
    }
    else if (Model.IsIncomplete)
    {
        <span style="color:red; font-weight:bold;">Incomplete ?</span>
    }
    else if (Model.IsPastDeadline)
    {
        <span style="color:orange; font-weight:bold;">Deadline Passed - Now Incomplete ??</span>
    }
    else
    {
        <span style="color:blue; font-weight:bold;">In Progress ?</span>
    }
</p>

<p><strong>Description:</strong> @Model.Description</p>
<p><strong>Start Date:</strong> @Model.StartDate.ToString("yyyy-MM-dd")</p>
<p><strong>End Date:</strong> @Model.EndDate.ToString("yyyy-MM-dd")</p>

<hr />

<h3>?? Test Plans</h3>
@if (Model.TestPlans != null && Model.TestPlans.Any())
{
    <ul>
        @foreach (var testPlan in Model.TestPlans)
        {
            <li>@testPlan.Name</li>
        }
    </ul>
}
else
{
    <p style="color:gray;">No test plans found for this project.</p>
}

<hr />

<form asp-action="DeleteProject" method="post">
    <input type="hidden" name="projectId" value="@Model.ProjectId" />
    <button type="submit"
            style="background-color:#dc3545; color:white; padding:8px 12px; border:none; border-radius:4px;"
            onclick="return confirm('Are you sure you want to delete this project?')">
        ?? Delete Project
    </button>
</form>
