@model OrganizationManagement.DTO.ProjectStatusGroupViewModel

<h2>📊 Project Status Summary</h2>

<h3 style="color:green;">✅ Completed Projects</h3>
@if (Model.CompletedProjects.Any())
{
    <ul>
        @foreach (var project in Model.CompletedProjects)
        {
            <li><strong>@project.ProjectName</strong> (Ends: @project.EndDate.ToString("yyyy-MM-dd"))</li>
        }
    </ul>
}
else
{
    <p>No completed projects.</p>
}

<h3 style="color:red;">❌ Incomplete Projects</h3>
@if (Model.IncompleteProjects.Any())
{
    <ul>
        @foreach (var project in Model.IncompleteProjects)
        {
            <li><strong>@project.ProjectName</strong> (Ends: @project.EndDate.ToString("yyyy-MM-dd"))</li>
        }
    </ul>
}
else
{
    <p>No incomplete projects.</p>
}

<h3 style="color:orange;">⏳ Pending Projects</h3>
@if (Model.PendingProjects.Any())
{
    <ul>
        @foreach (var project in Model.PendingProjects)
        {
            <li><strong>@project.ProjectName</strong> (Ends: @project.EndDate.ToString("yyyy-MM-dd"))</li>
        }
    </ul>
}
else
{
    <p>No pending projects.</p>
}
