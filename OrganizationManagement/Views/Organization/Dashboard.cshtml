@model List<OrganizationManagement.DTO.ProjectDTO>

@{
    ViewData["Title"] = "Organization Dashboard";
    var organizationId = ViewBag.OrganizationId;
}

<h2>Projects for Organization</h2>

<a asp-controller="Project" asp-action="AddProject" asp-route-organizationId="@organizationId" class="btn btn-primary">
    Add Project
</a>
<br />

@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var project in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@project.ProjectName</h5>
                        <p class="card-text">Project ID: @project.ProjectId</p>

                        <p class="card-text">
                            <strong>Status:</strong>
                            @{
                                var status = project.Status?.ToLower() ?? "";
                                var badgeClass = status switch
                                {
                                    "not started" => "bg-secondary",
                                    "in progress" => "bg-warning text-dark",
                                    "completed" => "bg-success",
                                    _ => "bg-danger"
                                };

                                var statusLabel = status switch
                                {
                                    "not started" => "Not Started ⚪",
                                    "in progress" => "In Progress ⏳",
                                    "completed" => "Completed ✅",
                                    _ => "Not Started ❓"
                                };
                            }
                            <span class="badge @badgeClass">@statusLabel</span>
                        </p>

                        <a href="@Url.Action("ProjectDashboard", "Project", new { projectId = project.ProjectId })" class="btn btn-outline-primary">View Details</a>

                        <form asp-action="DeleteProject" asp-controller="Project" method="post" class="mt-2" onsubmit="return confirmDelete(event)">
                            <input type="hidden" name="projectId" value="@project.ProjectId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">🗑 Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>No projects found for this organization.</p>
}

<script type="text/javascript">
    function confirmDelete(event) {
        if (!confirm("Are you sure you want to delete this project?")) {
            event.preventDefault();
        }
    }
</script>
