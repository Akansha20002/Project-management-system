@model List<OrganizationManagement.DTO.ProjectDTO>

<h2>Projects for Organization</h2>


@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var project in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@project.ProjectName</h5> <!-- Display ProjectName -->
                        <p class="card-text">
                            Project ID: @project.ProjectId
                        </p>
                        <a href="@Url.Action("ProjectDashboard", "Project", new { projectId = project.ProjectId })" class="btn btn-outline-primary">Go to Dashboard</a>

                        <form asp-action="DeleteProject" asp-controller="Project" method="post" class="mt-2" onsubmit="return confirmDelete(event)">
                            <input type="hidden" name="id" value="@project.ProjectId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">🗑 Delete</button>
                        </form>
                        
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>No projects found for this organization.</p>
}

<script type="text/javascript">
    function confirmDelete(event) {
        var confirmation = confirm("Are you sure you want to delete this project?");
        if (!confirmation) {
            event.preventDefault();  // Prevent the form submission if the user cancels
        }
    }
</script>
