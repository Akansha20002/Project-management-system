@model OrganizationManagement.DTO.TestPlanDTO
@{
    ViewData["Title"] = "Test Plan Details";
}

<h2>Test Plan Details</h2>

<div class="card p-3 shadow-sm">
    <dl class="row">
        <dt class="col-sm-3">Test Plan Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Objective</dt>
        <dd class="col-sm-9">@Model.Objective</dd>

        <dt class="col-sm-3">Created By</dt>
        <dd class="col-sm-9">@Model.CreatedBy</dd>

        <dt class="col-sm-3">Strategy</dt>
        <dd class="col-sm-9">@Model.Strategy</dd>

        <dt class="col-sm-3">Project ID</dt>
        <dd class="col-sm-9">@Model.ProjectId</dd>
    </dl>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.TestPlanId" class="btn btn-warning">Edit</a>
        <form asp-action="Delete" method="post" class="d-inline">
            <input type="hidden" name="id" value="@Model.TestPlanId" />
            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this test plan?');">Delete</button>
        </form>
        <a asp-action="ProjectDashboard" asp-controller="Project" asp-route-projectId="@Model.ProjectId" class="btn btn-secondary">Back to Project</a>
    </div>
</div>
