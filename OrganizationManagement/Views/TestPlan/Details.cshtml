@model OrganizationManagement.DTO.TestPlanDTO

@{
    ViewData["Title"] = "Test Plan Details";
}

<h2>Test Plan Details</h2>

<div class="card p-3 shadow-sm">
    <dl class="row">
        <dt class="col-sm-3">Test Plan Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Objective</dt>
        <dd class="col-sm-9">@Model.Objective</dd>

        <dt class="col-sm-3">Created By</dt>
        <dd class="col-sm-9">@Model.CreatedBy</dd>

        <dt class="col-sm-3">Strategy</dt>
        <dd class="col-sm-9">@Model.Strategy</dd>

        <dt class="col-sm-3">Project ID</dt>
        <dd class="col-sm-9">@Model.ProjectId</dd>
    </dl>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.TestPlanId" class="btn btn-warning">Edit</a>

        <form asp-action="Delete" method="post" class="d-inline">
            <input type="hidden" name="id" value="@Model.TestPlanId" />
            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this test plan?');">Delete</button>
        </form>

        <a asp-action="ProjectDashboard" asp-controller="Project" asp-route-projectId="@Model.ProjectId" class="btn btn-secondary">Back to Project</a>

        <a asp-controller="TestSuite" asp-action="Create" asp-route-testPlanId="@Model.TestPlanId" class="btn btn-primary">+ Add Test Suite</a>
    </div>
</div>

<hr />

<h3>Test Suites</h3>

@if (Model.TestSuites != null && Model.TestSuites.Any())
{
    <table class="table table-bordered mt-3">
        <thead class="thead-dark">
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var suite in Model.TestSuites)
            {
                <tr>
                    <td>@suite.Name</td>
                    <td>@suite.Description</td>
                    <td>

                        @* <a asp-controller="TestCase" asp-action="Create" asp-route-testSuiteId="@suite.TestSuiteId" class="btn btn-sm btn-success">Add Test Case</a> *@

                        @* <a href="@Url.Action("Create", "TestCase", new { testSuiteId = Model.TestSuiteId })" class="btn btn-sm btn-primary">Add Test Case</a> *@
                        <!-- Edit Button -->
                        <a asp-controller="TestSuite" asp-action="Edit" asp-route-id="@suite.TestSuiteId" class="btn btn-sm btn-warning">Edit</a>

                        <a asp-controller="TestSuite" asp-action="Details" asp-route-id="@suite.TestSuiteId" class="btn btn-sm btn-info">View Details</a>

                        
                        <!-- Delete Button -->
                        <form asp-controller="TestSuite" asp-action="Delete" asp-route-id="@suite.TestSuiteId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this test suite?');">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No test suites available for this test plan.</p>
}
