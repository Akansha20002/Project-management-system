@model OrganizationManagement.Models.TestPlan

@{
    ViewData["Title"] = "Add Test Plan";
}

<h2>Add Test Plan</h2>

<form asp-action="Add" method="post">
    @Html.AntiForgeryToken()

    <!-- Display validation summary -->
    <div asp-validation-summary="All" class="text-danger"></div>

    <!-- Hidden fields -->
    <input type="hidden" asp-for="CreatedBy" />
    <input type="hidden" asp-for="ProjectId" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Objective"></label>
        <textarea asp-for="Objective" class="form-control"></textarea>
        <span asp-validation-for="Objective" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Strategy"></label>
        <textarea asp-for="Strategy" class="form-control"></textarea>
        <span asp-validation-for="Strategy" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Add</button>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
