@{
}
@model OrganizationManagement.Models.TestPlan

@{
    ViewData["Title"] = "Edit Test Plan";
}

<h2>Edit Test Plan</h2>

<form asp-action="Edit" method="post">
    <div class="form-group">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label asp-for="Objective" class="form-label"></label>
        <textarea asp-for="Objective" class="form-control"></textarea>
        <span asp-validation-for="Objective" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <label asp-for="Strategy" class="form-label"></label>
        <textarea asp-for="Strategy" class="form-control"></textarea>
        <span asp-validation-for="Strategy" class="text-danger"></span>
    </div>

    <input type="hidden" asp-for="TestPlanId" />
    <input type="hidden" asp-for="CreatedBy" />
    <input type="hidden" asp-for="ProjectId" />

    <button type="submit" class="btn btn-primary mt-4">Save Changes</button>
    <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-secondary mt-4">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
