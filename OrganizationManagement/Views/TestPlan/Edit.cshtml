@model OrganizationManagement.DTO.TestPlanDTO
@{
    ViewData["Title"] = "Edit Test Plan";
}

<h2>Edit Test Plan</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="TestPlanId" />
    <input type="hidden" asp-for="ProjectId" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Objective"></label>
        <textarea asp-for="Objective" class="form-control"></textarea>
        <span asp-validation-for="Objective" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CreatedBy"></label>
        <input asp-for="CreatedBy" class="form-control" />
        <span asp-validation-for="CreatedBy" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Strategy"></label>
        <input asp-for="Strategy" class="form-control" />
        <span asp-validation-for="Strategy" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>
